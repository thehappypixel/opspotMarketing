# Marketing site (Astro) — copy this file to `.env` for local development.
# Astro inlines PUBLIC_* vars at build time via import.meta.env.PUBLIC_*.
# Production values are configured in DigitalOcean App Platform, not here.

# This marketing site's own origin (canonical URLs, Open Graph, sitemap)
PUBLIC_SITE_URL=http://localhost:4321

# The app host that signup/login CTAs point to
PUBLIC_APP_URL=http://localhost:3000

# Stripe PRICE ids (price_...) for the two plans shown on /pricing (monthly)
PUBLIC_STARTER_PLAN=price_xxxxxxxxxxxx
PUBLIC_PROFESSIONAL_PLAN_MONTHLY=price_xxxxxxxxxxxx

# Opinly headless blog (rendered at /blog, fetched at build time).
# SECRET server key — no PUBLIC_ prefix. From Opinly Settings → Developers.
OPINLY_API_KEY=
# Absolute CDN base URL Opinly serves post images from (for in-post images).
# Leave blank to render posts without images until you have the value.
OPINLY_IMAGES_PREFIX=
