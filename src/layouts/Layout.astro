---
import "../styles/global.css";
import { SITE_URL, GA_ID } from "../config";

const {
  title,
  description = "",
  keywords = "",
  ogTitle,
  ogDescription,
  ogType = "website",
  ogImage,
  twitterCard = "summary_large_image",
  bodyClass = "",
  jsonLd = [],
} = Astro.props;

// Canonical is derived from the real request path (fixes prior canonical bugs).
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
const ogImageURL = ogImage ? new URL(ogImage, Astro.site ?? SITE_URL) : undefined;

// Site-wide structured data, present in the raw HTML of every page. Individual
// pages can pass additional JSON-LD via the `jsonLd` prop.
const baseJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Opspot",
    url: SITE_URL,
    logo: `${SITE_URL}/logo512.png`,
    description:
      "Security operations software for small and mid-size security teams.",
    sameAs: ["https://www.linkedin.com/company/opspot-io"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Opspot",
    url: SITE_URL,
  },
];
const allJsonLd = [...baseJsonLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logo192.png" />
    <link rel="manifest" href="/manifest.json" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonicalURL.toString()} />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={resolvedOgTitle} />
    {resolvedOgDescription && (
      <meta property="og:description" content={resolvedOgDescription} />
    )}
    {ogImageURL && <meta property="og:image" content={ogImageURL.toString()} />}

    {/* Twitter */}
    <meta property="twitter:card" content={twitterCard} />
    <meta property="twitter:url" content={canonicalURL.toString()} />
    <meta property="twitter:title" content={resolvedOgTitle} />
    {resolvedOgDescription && (
      <meta property="twitter:description" content={resolvedOgDescription} />
    )}

    {/* Structured data (JSON-LD) */}
    {allJsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    {/* Google Analytics — per-browser internal-traffic opt-out.
        Visit ?ga_optout=1 to mark THIS browser as internal (disables GA here);
        ?ga_optout=0 clears it. Must run before gtag.js loads. Defaults to
        tracking ON, so real visitors are unaffected. */}
    <script is:inline define:vars={{ GA_ID }}>
      (function () {
        try {
          var p = new URLSearchParams(window.location.search);
          if (p.has("ga_optout")) {
            var v = p.get("ga_optout");
            if (v === "0" || v === "false") {
              localStorage.removeItem("ga_internal_traffic");
            } else {
              localStorage.setItem("ga_internal_traffic", "true");
            }
          }
          if (localStorage.getItem("ga_internal_traffic") === "true") {
            window["ga-disable-" + GA_ID] = true;
          }
        } catch (e) {}
      })();
    </script>
    {/* Google Analytics */}
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
    ></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", GA_ID);
    </script>

    {/* Instantly tracking */}
    <script
      id="vtag-ai-js"
      async
      src="https://r2.leadsy.ai/tag.js"
      data-pid="1By0aiclzEvKquoKA"
      data-version="062024"></script>

    {/* Opinly web analytics pixel. data-key is a public, write-only key. */}
    <script
      async
      src="https://static.opinly.ai/p.js"
      data-key="pk-uw_IyL5qwEdqpf4n7sR_KjT6-PMgLr8uLx05rrq"></script>
  </head>
  <body class={bodyClass}>
    <slot />

    {/* Delegated click analytics for server-rendered links/buttons. */}
    <script>
      import { initAnalyticsClient } from "../scripts/analyticsClient";
      initAnalyticsClient();
    </script>
  </body>
</html>
