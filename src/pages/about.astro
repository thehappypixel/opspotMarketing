---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/navigation.jsx";

const title = "About - Opspot Security Guard Management Software";
const description =
  "Learn about Opspot, security operations software for small and mid-size security teams.";
---

<Layout title={title} description={description}>
  <Navigation client:load pathname="/about" />
  <div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-4 text-white">About</h1>
    <p class="text-white">About information coming soon.</p>
  </div>
</Layout>
