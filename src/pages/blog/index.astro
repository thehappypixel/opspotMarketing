---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/navigation.jsx";
import Footer from "../../components/footer.jsx";
import { getAllPosts, postImage } from "../../lib/opinly.js";

const title = "Blog | Opspot";
const description =
  "Practical guides on running a small security guard company: scheduling, patrols, incident reporting, compliance, and proof of service.";
const keywords =
  "security guard blog, security operations, guard management tips, security company operations";

const posts = await getAllPosts();

const fmtDate = (iso) =>
  iso
    ? new Date(iso).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : "";
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  twitterCard="summary"
>
  <Navigation client:load pathname="/blog" />

  <div class="mt-24 py-16 sm:px-4 lg:px-24 w-full bg-black">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-xl leading-tight font-bold text-white text-center mb-6">
        Blog
      </h1>
      <p
        class="text-md tracking-wider leading-snug font-normal text-white text-center mb-12 md:w-3/4 mx-auto"
      >
        Practical guides on running a small security operation: scheduling,
        patrols, incident reporting, compliance, and proof of service.
      </p>
    </div>
  </div>

  <div class="bg-white py-16 sm:px-4 lg:px-24 w-full">
    <div class="max-w-6xl mx-auto">
      {
        posts.length === 0 ? (
          <p class="text-center text-gray-500 text-sm">
            No posts yet. Check back soon.
          </p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {posts.map((post) => {
              const img = postImage(post.image?.fileKey);
              return (
                <a
                  href={`/blog/${post.slug}`}
                  class="bg-white rounded-lg overflow-hidden transition-all duration-300 ease-in-out group flex flex-col shadow-md hover:shadow-xl hover:-translate-y-2"
                >
                  {img && (
                    <div class="aspect-video bg-gray-50 overflow-hidden">
                      <img
                        src={img}
                        alt={post.image?.altText || post.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    </div>
                  )}
                  <div class="p-6 flex-1 flex flex-col">
                    <p class="text-xs text-gray-400 mb-2">
                      {fmtDate(post.firstPublishedAt)}
                    </p>
                    <h2 class="text-sm font-bold tracking-tight leading-6 text-gray-900 mb-3">
                      {post.title}
                    </h2>
                    <p class="text-xsm text-gray-600 leading-relaxed flex-1">
                      {post.description}
                    </p>
                    <span class="mt-4 text-xsm font-medium text-brand-primary">
                      Read article →
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </div>

  <Footer />
</Layout>
