---
import Layout from "../../../layouts/Layout.astro";
import Navigation from "../../../components/navigation.jsx";
import Footer from "../../../components/footer.jsx";
import GuideArticleBody from "../../../components/guideArticleBody.jsx";
import securityOperationsGuidesContent from "../../../content/securityOperationsGuidesContent.jsx";

export function getStaticPaths() {
  return securityOperationsGuidesContent.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

const title = `${guide.metaTitle ?? guide.title} | Opspot`;
const description = guide.meta.description;
const keywords = guide.meta.keywords;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description: guide.meta.description,
    author: { "@type": "Organization", name: "Opspot" },
    publisher: { "@type": "Organization", name: "Opspot" },
  },
];
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  ogTitle={`${guide.title} | Opspot`}
  ogType="article"
  twitterCard="summary"
  jsonLd={jsonLd}
>
  <Navigation client:load pathname={`/resources/security-operations-guides/${guide.slug}`} />
  <GuideArticleBody guide={guide} />
  <Footer />
</Layout>
