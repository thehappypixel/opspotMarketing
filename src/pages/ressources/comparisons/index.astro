---
import Layout from "../../../layouts/Layout.astro";
import Navigation from "../../../components/navigation.jsx";
import Footer from "../../../components/footer.jsx";
import GuideCard from "../../../components/guideCard.jsx";
import comparisonsContent from "../../../content/comparisonsContent.jsx";

const title = "Comparisons - Opspot Security Guard Management Software";
const description =
  "Side-by-side comparisons to help security teams choose the right guard management software.";
const keywords =
  "security guard software comparisons, Opspot comparisons, guard management platform comparison";

const comparisons = [...comparisonsContent].reverse();
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  twitterCard="summary"
>
  <Navigation client:load pathname="/ressources/comparisons" />

  <div class="mt-24 py-16 sm:px-4 lg:px-24 w-full bg-black">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-xl leading-tight font-bold text-white text-center mb-6">
        Comparisons
      </h1>
      <p
        class="text-md tracking-wider leading-snug font-normal text-white text-center mb-12 md:w-3/4 mx-auto"
      >
        Straightforward comparisons to help security teams choose the right
        guard management software for their operations
      </p>
    </div>
  </div>

  <div class="bg-white py-16 sm:px-4 lg:px-24 w-full">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          comparisons.map((comparison) => (
            <GuideCard
              title={comparison.title}
              intro={comparison.intro}
              link={`/ressources/comparisons/${comparison.slug}`}
              readTime={comparison.readTime}
              buttonText="Read comparison"
            />
          ))
        }
      </div>
    </div>
  </div>

  <Footer />
</Layout>
