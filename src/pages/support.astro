---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/navigation.jsx";
import Footer from "../components/footer.jsx";
import Button from "../components/button.jsx";

const title = "Support - Opspot security guard software";
const description =
  "Get help with Opspot. Reach our team by email, browse our guides and how-to articles, or talk to us about setup and migrating your data.";
const keywords =
  "opspot support, security guard software help, opspot help, guard software onboarding";

// NOTE: confirm this support address routes correctly before launch.
const supportEmail = "support@opspot.io";

const helpLinks = [
  {
    label: "Security operations guides",
    to: "/resources/security-operations-guides",
  },
  { label: "How-to articles", to: "/resources/how-to-articles" },
  { label: "Walkthroughs", to: "/resources/walkthroughs" },
];
---

<Layout title={title} description={description} keywords={keywords}>
  <Navigation client:load pathname="/support" />

  {/* Hero */}
  <div class="bg-black pt-48 pb-24 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-brand-primary text-xxs font-medium uppercase tracking-widest mb-4">
        Support
      </p>
      <h1 class="text-white text-xl leading-tight font-bold mb-6">
        We are here to help
      </h1>
      <p class="text-gray-400 text-md leading-relaxed">
        Whether you are getting set up or running day to day, real people on our
        team are ready to help you get the most out of Opspot.
      </p>
    </div>
  </div>

  {/* Support options */}
  <div class="bg-white py-24 px-6">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
      {/* Email */}
      <div class="border border-gray-200 rounded-xl p-8">
        <h2 class="text-md font-bold mb-3">Email us</h2>
        <p class="text-xs text-gray-500 leading-relaxed mb-5">
          Send us a question and we will get back to you, usually within one
          business day.
        </p>
        <a
          href={`mailto:${supportEmail}`}
          class="text-sm font-medium text-brand-primary hover:underline"
          data-track="link"
          data-track-text="support_email"
          data-track-dest={`mailto:${supportEmail}`}
        >
          {supportEmail}
        </a>
      </div>

      {/* Onboarding / migration */}
      <div class="border border-gray-200 rounded-xl p-8">
        <h2 class="text-md font-bold mb-3">Setup and migration help</h2>
        <p class="text-xs text-gray-500 leading-relaxed mb-5">
          New to Opspot or moving from another tool? We set up your account and
          migrate your data for you, so you are live inside of a week.
        </p>
        <a
          href="/contact"
          class="text-sm font-medium text-brand-primary hover:underline"
          data-track="link"
          data-track-text="support_onboarding_contact"
          data-track-dest="/contact"
        >
          Talk to us about getting started
        </a>
      </div>
    </div>

    {/* Self-serve help */}
    <div class="max-w-4xl mx-auto mt-16">
      <h2 class="text-lg leading-tight font-bold mb-3 text-center">
        Help yourself, any time
      </h2>
      <p class="text-sm text-gray-500 leading-relaxed text-center max-w-2xl mx-auto mb-10">
        Browse our guides and articles to learn how to run patrols, incidents,
        scheduling, and reporting in Opspot.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          helpLinks.map((link) => (
            <a
              href={link.to}
              class="block border border-gray-200 rounded-xl p-6 text-sm font-medium text-gray-700 hover:border-brand-primary hover:text-brand-primary transition-colors"
              data-track="link"
              data-track-text={`support_help_${link.label}`}
              data-track-dest={link.to}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  {/* Book a call */}
  <div class="bg-black py-24 px-6">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="text-white text-lg leading-tight font-bold mb-6">
        Prefer to talk it through?
      </h2>
      <p class="text-gray-400 text-sm mb-10 leading-relaxed">
        Book a call with our team and we will walk you through Opspot and answer
        your questions.
      </p>
      <div class="flex justify-center">
        <Button
          text="Book a call"
          icon={true}
          iconPosition="right"
          density="tight"
          location="support_book_call"
          link="/contact"
        />
      </div>
    </div>
  </div>

  <Footer />
</Layout>
